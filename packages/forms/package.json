{
  "name": "@labmgm/forms",
  "version": "0.1.1",
  "description": "Form primitives for MGM Laboratory — Input, Textarea, Select, Combobox, Switch, Slider, FileDropzone, Wizard, plus React Hook Form + Zod helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labmgm/ds-design-system.git",
    "directory": "packages/forms"
  },
  "homepage": "https://github.com/labmgm/ds-design-system/tree/main/packages/forms#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.mjs",
      "require": "./dist/schemas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@labmgm/icons": "workspace:*",
    "@labmgm/utils": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "cmdk": "^1.0.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@labmgm/eslint-config": "workspace:*",
    "@labmgm/typescript-config": "workspace:*",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
