{
  "name": "@labmgm/fonts",
  "version": "0.1.3",
  "description": "Font loaders for Bricolage Grotesque, Geist, and Geist Mono — the MGM type stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labmgm/ds-design-system.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/labmgm/ds-design-system/tree/main/packages/fonts#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/fonts.css dist/fonts.css",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@labmgm/eslint-config": "workspace:*",
    "@labmgm/typescript-config": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "next": "^15.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
