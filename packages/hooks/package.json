{
  "name": "@labmgm/hooks",
  "version": "0.1.2",
  "description": "Useful React hooks for MGM Laboratory: useMediaQuery, useDebounce, useThrottle, useLocalStorage, useClickOutside, useKeyboardShortcut, useCopyToClipboard, useIntersectionObserver, useResizeObserver, useReducedMotion, useControllableState.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labmgm/ds-design-system.git",
    "directory": "packages/hooks"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@labmgm/eslint-config": "workspace:*",
    "@labmgm/typescript-config": "workspace:*",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
