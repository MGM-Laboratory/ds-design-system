{
  "name": "@labmgm/tailwind-config",
  "version": "0.1.0",
  "description": "Tailwind CSS preset that wires every MGM Laboratory design token.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labmgm/ds-design-system.git",
    "directory": "packages/tailwind-config"
  },
  "homepage": "https://github.com/labmgm/ds-design-system/tree/main/packages/tailwind-config#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@labmgm/tokens": "workspace:*",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@labmgm/eslint-config": "workspace:*",
    "@labmgm/typescript-config": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "tailwindcss": "^3.4.13",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
